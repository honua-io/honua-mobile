<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      Self-contained migration tooling. Deliberately does NOT reference the MAUI
      workload or the Honua.Sdk.* packages: the codemod operates on MAUI source
      code as text/Roslyn syntax, so it must build and run on any platform
      without the Android/iOS workloads installed.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Honua.Migrate.Maui.Tests" />
    <InternalsVisibleTo Include="Honua.Migrate.Maui.Cli" />
  </ItemGroup>

</Project>
