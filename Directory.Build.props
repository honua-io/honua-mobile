<Project>
  <PropertyGroup>
    <!--
      Honua .NET SDK 0.1.17-alpha.1 — bundles the mobile-shim consolidation:
        - Honua.Sdk.Geometry.GeographicBoundingBox (SDK PR #151)
        - Mobile DTO consolidation (SDK PR #152)
        - Honua.Sdk.Offline.ReplicaSyncClient (SDK PR #153)
        - Transport-mapping migration (SDK PR #154)
        - Public-API + transitive Geometry surface (SDK PR #155)

      See docs/guides/sdk-contract-stability.md for the stability roadmap and
      exit criteria that govern when this train moves from alpha -> beta -> stable.
    -->
    <HonuaSdkDotNetTrainVersion>0.1.17-alpha.1</HonuaSdkDotNetTrainVersion>
    <HonuaSdkDotNetTrainTag>dotnet-sdk-v$(HonuaSdkDotNetTrainVersion)</HonuaSdkDotNetTrainTag>
    <HonuaSdkDotNetTrainRepository>honua-io/honua-sdk-dotnet</HonuaSdkDotNetTrainRepository>
    <HonuaSdkDotNetTrainReleaseUrl>https://github.com/honua-io/honua-sdk-dotnet/releases/tag/$(HonuaSdkDotNetTrainTag)</HonuaSdkDotNetTrainReleaseUrl>
    <HonuaSdkDotNetTrainReleaseCommit>77da0cf</HonuaSdkDotNetTrainReleaseCommit>
    <HonuaSdkDotNetTrainReleasePublishedAt>2026-05-20T07:42:55Z</HonuaSdkDotNetTrainReleasePublishedAt>
    <MauiVersion>10.0.60</MauiVersion>
  </PropertyGroup>
</Project>
