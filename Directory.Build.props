<Project>
  <PropertyGroup>
    <!-- Released Honua .NET SDK train with net11.0 assets. -->
    <HonuaSdkDotNetTrainVersion>5.1.0</HonuaSdkDotNetTrainVersion>
    <HonuaSdkDotNetTrainTag>trunk</HonuaSdkDotNetTrainTag>
    <HonuaSdkDotNetTrainRepository>honua-io/honua-sdk-dotnet</HonuaSdkDotNetTrainRepository>
    <HonuaSdkDotNetTrainReleaseUrl>https://github.com/honua-io/honua-sdk-dotnet/releases/tag/dotnet-sdk-v5.1.0</HonuaSdkDotNetTrainReleaseUrl>
    <HonuaSdkDotNetTrainReleaseCommit>592822fe8cdf61afe2c196ec86451ea44685e16a</HonuaSdkDotNetTrainReleaseCommit>
    <HonuaSdkDotNetTrainReleasePublishedAt>2026-11-24T18:50:38Z</HonuaSdkDotNetTrainReleasePublishedAt>
    <!-- Set to the published Honua.Sdk.Field version with asset-request support
         to include the .NET 11 assigned-work adapter in signed Mobile releases. -->
    <HonuaWorkTasksSdkVersion Condition="'$(HonuaWorkTasksSdkVersion)' == ''"></HonuaWorkTasksSdkVersion>
    <MauiVersion>11.0.10</MauiVersion>

    <!--
      geospatial-grpc conformance fixtures — pinned source of truth for the
      Live Server Integration contract checks (Compatibility Train, epic
      geospatial-grpc#18). The Live Server Integration workflow pulls this exact
      fixture version via tests/conformance/fetch-fixtures.sh from the
      v$(HonuaConformanceFixturesVersion) GitHub Release of
      honua-io/geospatial-grpc; the version maps 1:1 to a geospatial.v1 schema
      release. Provenance is recorded in tests/conformance/UPSTREAM.md. Bump this
      pin (and UPSTREAM.md) in lockstep when adopting a newer fixture release.
    -->
    <HonuaConformanceFixturesVersion>0.1.0-alpha.1</HonuaConformanceFixturesVersion>
    <HonuaConformanceFixturesRepository>honua-io/geospatial-grpc</HonuaConformanceFixturesRepository>
  </PropertyGroup>

  <!--
    NuGet audit suppression for GHSA-2m69-gcr7-jv3q (NU1903) against the native
    SQLitePCLRaw e_sqlite3 library (2.1.x). The advisory is fixed in the 3.x
    SQLitePCLRaw line, but SQLitePCLRaw.bundle_green has no 3.x release yet, so
    there is no compatible upgrade path on the current line. The bundled native
    library is shipped with the app rather than dynamically loaded. Remove this
    suppression once a 3.x bundle_green (or patched 2.1.x lib.e_sqlite3) is
    available and pinned.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>
</Project>
