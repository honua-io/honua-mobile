<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>Honua.Mobile.Templates</id>
    <version>1.0.0</version>
    <title>Honua Mobile SDK Project Templates</title>
    <authors>Honua Project</authors>
    <owners>Honua Project</owners>
    <description>
      `dotnet new` project templates for the Honua Mobile SDK.

      Included Templates:
      - honua-fieldcollector — offline-first field data collection app built on .NET MAUI, with forms, GPS, photos, and GeoPackage-backed sync.

      Features:
      - Dynamic form generation from server schemas
      - GPS location tracking
      - Photo capture with metadata
      - Offline-first architecture with GeoPackage storage and queued sync
      - Cross-platform (iOS, Android, Windows, macOS)

      Apache 2.0 licensed.
    </description>
    <releaseNotes>
      1.0.0:
      - Initial release with the `honua-fieldcollector` template.
    </releaseNotes>
    <summary>`dotnet new` templates for building offline-first geospatial mobile apps with the Honua Mobile SDK.</summary>
    <language>en-US</language>
    <projectUrl>https://github.com/honua/honua-mobile-sdk</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/honua/honua-mobile-sdk/main/assets/icon-128.png</iconUrl>
    <icon>icon-128.png</icon>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <licenseUrl>https://github.com/honua/honua-mobile-sdk/blob/main/LICENSE</licenseUrl>
    <copyright>© 2026 Honua Project. Licensed under Apache 2.0.</copyright>
    <tags>
      dotnet-new template templates maui mobile geospatial gis
      field-collection data-collection offline-first cross-platform
      forms gps photos sync mapping
      csharp xaml
    </tags>
    <packageTypes>
      <packageType name="Template" />
    </packageTypes>
  </metadata>
  <files>
    <!-- Field Collector Template -->
    <file src="honua-fieldcollector\**\*" target="content\honua-fieldcollector\" exclude="**\bin\**;**\obj\**;**\.vs\**;**\*.user" />

    <!-- Documentation -->
    <file src="README.md" target="content\README.md" />
    <file src="LICENSE" target="content\LICENSE" />

    <!-- Icon -->
    <file src="icon-128.png" target="icon-128.png" />
  </files>
</package>
