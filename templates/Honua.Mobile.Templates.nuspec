<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>Honua.Mobile.Templates</id>
    <version>1.0.0</version>
    <title>Honua Mobile SDK Project Templates</title>
    <authors>Honua Project</authors>
    <owners>Honua Project</owners>
    <description>
      .NET project templates for the Honua Mobile SDK.

      Included Templates:
      - honua-fieldcollector - Complete field data collection app with forms, GPS, photos, and offline GeoPackage sync.

      Features:
      - Dynamic form generation from SDK-owned schemas
      - GPS location tracking with accuracy display
      - Photo capture with metadata
      - Offline-first architecture with GeoPackage sync queue
      - Cross-platform (iOS, Android, Windows)
    </description>
    <releaseNotes>
      1.0.0:
      - Initial release with the honua-fieldcollector template.
    </releaseNotes>
    <summary>.NET templates for creating geospatial mobile apps with the Honua Mobile SDK.</summary>
    <language>en-US</language>
    <projectUrl>https://github.com/honua-io/honua-mobile</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/honua-io/honua-mobile/trunk/assets/icon-128.png</iconUrl>
    <icon>icon-128.png</icon>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <licenseUrl>https://github.com/honua-io/honua-mobile/blob/trunk/LICENSE</licenseUrl>
    <copyright>(c) 2026 Honua Project. Licensed under Apache 2.0.</copyright>
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Microsoft.TemplateEngine.Abstractions" version="10.0.0" />
      </group>
    </dependencies>
    <tags>
      dotnet-new template templates maui mobile geospatial gis
      field-collection data-collection offline-first cross-platform
      forms gps photos sync mapping csharp xaml
    </tags>
    <packageTypes>
      <packageType name="Template" />
    </packageTypes>
  </metadata>
  <files>
    <!-- Field Collector Template -->
    <file src="honua-fieldcollector\**\*" target="content\honua-fieldcollector\" exclude="**\bin\**;**\obj\**;**\.vs\**;**\*.user" />

    <!-- Template Engine Files -->
    <file src="**\.template.config\**\*" target="content\" />

    <!-- Icon -->
    <file src="icon-128.png" target="icon-128.png" />
  </files>
</package>
