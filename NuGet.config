<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github-honua" value="https://nuget.pkg.github.com/honua-io/index.json" />
    <!--
      Local bridge feed for the Honua.Sdk.* 0.1.17-alpha.2 prerelease
      that contains the mobile-shim consolidation (DTOs, GeographicBoundingBox,
      ReplicaSyncClient, transport mappings, public converters).
      REMOVE after the SDK publishes an alpha containing the same set
      to nuget.pkg.github.com/honua-io.
    -->
    <add key="honua-local" value="/home/makani/local-nuget-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github-honua">
      <package pattern="Geospatial.Grpc" />
      <package pattern="Honua.Core" />
      <package pattern="Honua.Mobile.*" />
    </packageSource>
    <packageSource key="honua-local">
      <package pattern="Honua.Sdk.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
